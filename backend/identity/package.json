{
  "name": "@cricketiq/identity",
  "version": "1.0.0",
  "description": "Identity Service - Authentication & Authorization for CricketIQ",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node -r ts-node/register -r tsconfig-paths/register src/server.ts",
