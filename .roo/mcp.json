{
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}"
			],
			"alwaysAllow": [
				"search_files",
				"create_directory"
			]
		},
		"git": {
			"command": "uvx",
			"args": [
				"mcp-server-git",
				"--repository",
				"${workspaceFolder}"
			],
			"disabled": true,
			"alwaysAllow": []
		},
		"postgresql": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://roo_readonly:strong-password@192.168.1.109:5439/cricketiq"
			],
			"disabled": true,
			"alwaysAllow": []
		},
		"firecrawl": {
			"command": "npx",
			"args": [
				"-y",
				"firecrawl-mcp"
			],
			"env": {
				"FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
			},
			"disabled": true,
			"alwaysAllow": []
		},
		"brave-search": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-brave-search"
			],
			"env": {
				"BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
			},
			"disabled": false,
			"alwaysAllow": []
		},
		"chrome-devtools": {
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest"
			],
			"disabled": true,
			"alwaysAllow": []
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest"
			],
			"alwaysAllow": [
				"browser_take_screenshot",
				"browser_console_messages",
				"browser_snapshot",
				"browser_click",
				"browser_fill_form",
				"browser_press_key",
				"browser_navigate",
				"browser_find"
			]
		}
	}
}