# Repository Brain environment configuration.
# Copy to .env and adjust values as needed.

# --- Application ---
APP_NAME=repository-brain
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL is the production database.
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./storage/brain.db

# --- Storage ---
# Root directory where per-repository data and snapshots live.
STORAGE_DIR=./storage

# Allowed root directories that repositories may be registered from.
# Comma separated absolute paths. Empty allows any path.
ALLOWED_REPOSITORY_ROOTS=

# --- Security ---
# Secret used to sign JWT / API tokens (if authentication is enabled).
SECRET_KEY=change-me-in-production

# --- Workers ---
# Number of worker threads used for parallel file parsing.
INDEXER_WORKERS=4

# Auto re-scan interval in seconds for watched repositories (0 disables).
WATCH_INTERVAL=0

# --- OpenAI-compatible proxy (Phase 1) ---
# Upstream OpenAI-compatible backend (e.g. llama.cpp serving Qwen3).
# This is the base URL including the /v1 API path; requests are forwarded as-is,
# so chat completions resolve to http://localhost:8033/v1/chat/completions.
OPENAI_BACKEND=http://localhost:8033/v1

# API key sent to the upstream backend. Leave empty to omit the Authorization header.
# Use your real key here (it is never logged); do not commit a real key to version control.
OPENAI_API_KEY=

# Upstream model name. The model field of incoming requests (e.g. "repository-brain-v1")
# is mapped to this value before being forwarded to the backend.
OPENAI_MODEL=qwen35b

# Model name advertised by GET /api/v1/models. This is the model clients (e.g. Roo Code)
# request; it is mapped to OPENAI_MODEL before forwarding upstream.
OPENAI_ADVERTISED_MODEL=repository-brain-v1

# Request/stream timeout in seconds (optional, default 300).
OPENAI_TIMEOUT=300
